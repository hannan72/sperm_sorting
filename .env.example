# Copy to .env and adjust. Every value here is also settable from the command
# line with `-s key.path=value`, and the config file is the source of truth --
# these exist for values that differ per machine or must not be committed.

# ---- Hardware -------------------------------------------------------------
# Serial number of the Basler camera; unset takes the first one found.
SPERM_CAMERA_SERIAL=

# Serial port of the magnet controller, for actuation.kind=serial.
SPERM_ACTUATOR_PORT=/dev/ttyUSB0

# GPIO line driving the field enable, for actuation.kind=gpio.
SPERM_GPIO_CHIP=/dev/gpiochip0
SPERM_GPIO_PIN=

# ---- Calibration ----------------------------------------------------------
# These are properties of the built instrument and are UNKNOWN until measured.
# Leave them empty rather than guessing: the system refuses to report physical
# units or to actuate while they are unset, which is the intended behaviour.
# Measure with scripts/calibrate_optics.py and scripts/calibrate_transport_delay.py.
SPERM_UM_PER_PX=
SPERM_TRANSPORT_DELAY_MS=
SPERM_FIELD_RISE_MS=
SPERM_FIELD_FALL_MS=

# ---- Runtime --------------------------------------------------------------
SPERM_DEVICE=cpu                  # cpu | cuda | cuda:0
SPERM_LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR
SPERM_AUDIT_DIR=runs              # empty disables audit logging
SPERM_RUN_NAME=default

# ---- Datasets -------------------------------------------------------------
# Roots of the public datasets. None are redistributed with this repository;
# see datasets/README.md for how to obtain each and docs/license_audit.md for
# what each licence permits.
MHSMA_ROOT=data/mhsma
VISEM_TRACKING_ROOT=data/visem-tracking
VISEM_ROOT=data/visem
DETECTION_SPERM_ROOT=data/miamia-svds
DEVICE_DATA_ROOT=data/device
